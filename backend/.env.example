# Copy to .env and fill in real values. Never commit the .env file itself.

LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-replace-me

SHOPIFY_STORE_DOMAIN=your-shop.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_replace-me

STOREFRONT_ORIGIN=https://storefront.example.com

# Neon Postgres connection string. The API reads synced entries from here on
# boot; `python -m app.sync` is the only process that writes to it.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
